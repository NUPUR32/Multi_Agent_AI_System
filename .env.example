# =============================================================================
# NUPUR32® AI Operating System - Environment Configuration
# =============================================================================

# --- System Settings ---
ENVIRONMENT=development
DEBUG=true
DEFAULT_MODEL=gpt-4o
FALLBACK_MODEL=claude-3.5-sonnet
EMBEDDING_MODEL=text-embedding-3-large

# --- AI Model API Keys ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-key
XAI_API_KEY=your-xai-key
DEEPSEEK_API_KEY=your-deepseek-key
GROQ_API_KEY=your-groq-key
TOGETHER_API_KEY=your-together-key
HUGGINGFACE_TOKEN=your-huggingface-token

# --- Security ---
NUPUR32_MASTER_KEY=your-master-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
ENCRYPTION_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE_MB=100
ENABLE_AUDIT_LOG=true
PROMPT_INJECTION_PROTECTION=true

# --- Database URLs ---
POSTGRES_URL=postgresql://localhost:5432/nupur32
MONGODB_URL=mongodb://localhost:27017/nupur32
REDIS_URL=redis://localhost:6379
NEO4J_URL=bolt://localhost:7687
ELASTICSEARCH_URL=http://localhost:9200
VECTOR_DB_URL=http://localhost:6333
SQLITE_PATH=data/nupur32.db

# --- External API Keys ---
SERPER_API_KEY=your-serper-key
TAVILY_API_KEY=your-tavily-key
BROWSERLESS_API_KEY=your-browserless-key

# --- Monitoring ---
TRACING_ENDPOINT=http://localhost:4318
METRICS_PORT=9090
ENABLE_GPU_MONITORING=true
ENABLE_ALERTS=true

# --- Storage ---
STORAGE_BACKEND=local  # local, s3, gcs, azure
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=nupur32-storage